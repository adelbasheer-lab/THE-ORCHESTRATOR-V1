NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://orchestrator:orchestrator@localhost:5432/orchestrator
WORKSPACE_ROOT=.workspaces

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GITHUB_TOKEN=
GITHUB_REPOSITORY=OWNER/REPO
GITHUB_BASE_BRANCH=main

MAX_AGENT_TURNS=8
MAX_TASK_MINUTES=30

# Optional remote MCP servers, one JSON object per line:
# MCP_SERVERS_JSON=[{"name":"example","url":"https://example.com/mcp","authToken":"..."}]
MCP_SERVERS_JSON=[]
