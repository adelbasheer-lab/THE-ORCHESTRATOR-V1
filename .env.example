NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://orchestrator:orchestrator@localhost:5432/orchestrator
WORKSPACE_ROOT=.workspaces

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Claude implementation provider:
# "anthropic-api" (default) or "claude-code"
CLAUDE_AGENT=anthropic-api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_ALLOWED_TOOLS=Read,Edit,Bash,Glob,Grep
CLAUDE_CODE_TIMEOUT_MS=1800000

GITHUB_TOKEN=
GITHUB_REPOSITORY=OWNER/REPO
GITHUB_ALLOWED_REPOSITORIES=OWNER/REPO
GITHUB_BASE_BRANCH=main

ORCHESTRATOR_API_KEY=
ORCHESTRATOR_APPROVAL_KEY=
ORCHESTRATOR_ALLOW_ANONYMOUS_DEV=true

MAX_AGENT_TURNS=8
MAX_TASK_MINUTES=30
TEST_TIMEOUT_MS=1800000
KEEP_FAILED_WORKSPACES=false
ALLOWED_TEST_COMMANDS=npm test

# HTTPS only. Reviewer MCP access requires readOnly=true.
# allowedTools can further restrict the visible MCP surface.
MCP_SERVERS_JSON=[]
